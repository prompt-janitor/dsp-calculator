{
  "name": "dsp-calculator",
  "version": "1.0.0",
  "private": true,
  "description": "Production planner for Dyson Sphere Program",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint:copy": "node scripts/lint-copy.mjs",
    "licenses": "node scripts/add-licenses.mjs",
    "serve": "npm run build && node scripts/serve.mjs",
    "assets": "node scripts/gen-assets.cjs",
    "snapshot": "node scripts/snapshot.mjs",
    "test:e2e": "npm run build && playwright test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "playwright": "^1.64.1"
  }
}
